# Interactive Recipe Finder - Environment Variables Example
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control

# Required: Spoonacular API Key
# Get your free API key from: https://spoonacular.com/food-api
SPOONACULAR_API_KEY=your_spoonacular_api_key_here

# Optional: Analytics
# MIXPANEL_TOKEN=your_mixpanel_token_here

# Optional: Image Optimization
# CLOUDINARY_API_KEY=your_cloudinary_api_key_here

# Note: For Vercel/Netlify deployment, set these as environment variables
# in your project settings instead of using a .env file
